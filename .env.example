# Dominio publico de la API (Caddy, requerido para HTTPS) y frontend (Vercel). Sin barra final.
API_DOMAIN=api.michisushigranada.com
FRONTEND_URL=https://michisushigranada.com

# Secreto compartido gateway <-> oauth. Genera uno largo: openssl rand -hex 64
JWT_SECRET=

# Mongo Atlas (mismo para productos, reservas y oauth salvo que uses otro cluster)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/michi?retryWrites=true&w=majority

# Productos - Uber
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_STORE_UUID=
UBER_ORG_UUID=

# Reservas - correo
MAIL_USERNAME=
MAIL_PASSWORD=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# OAuth - Google Cloud Console (redirect URI https://api.michisushigranada.com/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
