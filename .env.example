# Dominio publico de la API (Caddy, requerido para HTTPS) y frontend (Vercel). Sin barra final.
# Como aun no usas dominio propio, usa el wildcard nip.io con la IP de Hetzner.
API_DOMAIN=2.31.133.197.nip.io
FRONTEND_URL=https://michi-app-pi.vercel.app

# Secreto compartido gateway <-> oauth. Genera uno largo: openssl rand -hex 64
JWT_SECRET=cambia-este-secreto-largo-minimo-64-caracteres

# Mongo Atlas M0 (mismo para productos, reservas y oauth salvo que uses otro cluster)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/michi?retryWrites=true&w=majority

# Productos - Uber
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_STORE_UUID=
UBER_ORG_UUID=

# Reservas - correo
MAIL_USERNAME=
MAIL_PASSWORD=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# OAuth - Google Cloud Console (redirect URI https://2.31.133.197.nip.io/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
